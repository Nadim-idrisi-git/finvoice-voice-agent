NODE_ENV=development
PORT=4100
# Comma-separated allowed origins; * may match part of a host (e.g. https://finvoice*.vercel.app)
WEB_ORIGIN=http://localhost:5173
# Set to true to serve the synthetic demo API when NODE_ENV=production
DEMO_MODE=false
MONGODB_URI=mongodb://127.0.0.1:27017/voice_financial_agent

# OpenAI: optional. Without a key, text chat uses the rule-based assistant and voice is disabled.
OPENAI_API_KEY=
# Text agent (Responses API with tool calling)
OPENAI_MODEL=gpt-6-luna
# Live voice (Realtime API over WebRTC)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Requests per minute per client for text chat
ASSISTANT_RATE_LIMIT=20

# Dataset ingestion (npm run ingest): where the buildathon data lives and which user to build the call for
DATASET_DIR=~/Downloads/buildathon
DEMO_USER_ID=1748108541385190

# Text agent reasoning effort (empty = model default). Measured 2026-10-17: "none" was ~12% faster at p50
# but produced 3 unsupported answers the validator had to correct, so the default is kept.
OPENAI_REASONING_EFFORT=
