NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/voice_financial_agent

# OpenAI: optional. Without a key, text chat uses the rule-based assistant and voice is disabled.
OPENAI_API_KEY=
# Text agent (Responses API with tool calling)
OPENAI_MODEL=gpt-6-luna

# Voice: ElevenLabs speech-to-text and text-to-speech (key needs Text to Speech + Speech to Text permissions)
ELEVENLABS_API_KEY=
# Empty = first premade voice on the account. Voice Library voices need a paid plan.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# Requests per minute per client for text chat
ASSISTANT_RATE_LIMIT=20

# Dataset ingestion (npm run ingest): where the buildathon data lives and which user to build the call for
DATASET_DIR=~/Downloads/buildathon
DEMO_USER_ID=1748108541385190
