NODE_ENV=development
PORT=4100
# Comma-separated allowed origins; * may match part of a host (e.g. https://finvoice*.vercel.app)
WEB_ORIGIN=http://localhost:5173
# Set to true to serve the synthetic demo API when NODE_ENV=production
DEMO_MODE=false
MONGODB_URI=mongodb://127.0.0.1:27017/voice_financial_agent

# Gemini: optional. Without a key, text chat uses the rule-based assistant and voice is disabled.
GEMINI_API_KEY=
# Text agent (generateContent with tool calling)
GEMINI_MODEL=gemini-3.8-flash
# Live voice (Live API over WebSocket, native audio). Voices: Kore, Aoede, Leda, Zephyr, Puck, Charon, Orus, Fenrir
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore

# Requests per minute per client for text chat
ASSISTANT_RATE_LIMIT=20

# Dataset ingestion (npm run ingest): where the buildathon data lives and which user to build the call for
DATASET_DIR=~/Downloads/buildathon
DEMO_USER_ID=1748108541385190

# Text agent thinking level: minimal, low, medium, high (empty = low). Measured 2026-10-18 on the 35-case suite:
# low 35/32/35 (p50 4-5s), medium 34 (p50 6.4s), high 34/32 (p50 7-9s, some 30s timeouts),
# gemini-pro-latest 31 (p50 13.9s).
GEMINI_THINKING_LEVEL=
